# ============================================================
# AI Grocery Flyer Platform — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your API keys.
# NEVER commit .env.local to git.

# ------------------------------------------------------------
# Salling Group (Netto, Føtex, Bilka, Salling, Basalt)
# Free API — register at: https://developer.sallinggroup.com
# Rate limit: 10,000 requests/day
# ------------------------------------------------------------
SALLING_API_KEY=

# ------------------------------------------------------------
# Coop Danmark (365discount, SuperBrugsen, Kvickly, Dagli'Brugsen)
# Free with registration — get key at: https://developer.cl.coop.dk
# ------------------------------------------------------------
COOP_SUBSCRIPTION_KEY=

# ------------------------------------------------------------
# REMA 1000
# Free with registration — register at: https://apiportal.rema.no
# Note: Commercial use may require license agreement with REMA 1000.
# ------------------------------------------------------------
REMA_SUBSCRIPTION_KEY=

# ------------------------------------------------------------
# Tjek / eTilbudsavis (covers ALL Danish chains)
# The legacy v2 API (api.etilbudsavis.dk) may work without a key.
# For commercial access, contact: services@tjek.com
# Leave blank to attempt unauthenticated (legacy) access.
# ------------------------------------------------------------
TJEK_API_KEY=
