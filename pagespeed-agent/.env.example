# ─── Required ──────────────────────────────────────────────────────────────────

# URL of the live site to audit and optimize
TARGET_URL=https://yoursite.com

# Google PageSpeed Insights API key
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "PageSpeed Insights API" in your project first
PSI_API_KEY=your_psi_api_key_here

# Absolute path to the site's source files on disk
# The agent edits files here, then you deploy
SITE_PATH=/path/to/your/site

# ─── Optional ──────────────────────────────────────────────────────────────────

# Anthropic API key — enables AI-assisted fixes (alt text, meta descriptions, etc.)
# If omitted, the agent uses filename-based heuristics instead
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local dev server URL — used for fast Lighthouse feedback during the fix loop
# If omitted, the agent skips local testing and uses the PSI API for every check
# Start your dev server before running the agent (e.g. npm run dev)
LOCAL_URL=http://localhost:3000

# Strategy to target: "mobile" | "desktop" | "both" (default: both)
STRATEGY=both

# Maximum fix iterations before stopping (default: 30)
MAX_ITERATIONS=30

# How many PSI runs to average for each score measurement (default: 3)
# More runs = more accurate, but slower. Min: 1, Max: 5
PSI_RUNS=3

# Site stack hint — speeds up fix targeting
# "static" | "nextjs" | "nuxt" | "astro" | "wordpress" | "express" | "auto" (default: auto)
SITE_STACK=auto

# Only fix these categories (comma-separated, or "all")
# e.g. "performance,accessibility" to skip best-practices and seo
FIX_CATEGORIES=all

# Dry run — show what would be fixed without changing any files
DRY_RUN=false
